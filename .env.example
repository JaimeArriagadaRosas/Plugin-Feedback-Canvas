# =============================================================================
# Plugin Feedback - EJEMPLO de Variables de Entorno
# Copia este archivo a ".env" y completa los valores reales (que NO se commitean).
# =============================================================================

CANVAS_BASE_URL=https://localhost:8443
CANVAS_ISSUER=https://localhost:8443
CANVAS_ACCESS_TOKEN=

DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_db_password_strong
DB_NAME=feedback_plugin_db
DB_PORT=5432

# Genera con: node -e "crypto.randomBytes(32).toString('hex')"
ENCRYPTION_KEY=CHANGE_ME_encryption_key_64_hex
WEBHOOK_SECRET=CHANGE_ME_webhook_secret_64_hex
DEV_TOKEN_SECRET=CHANGE_ME_dev_token_secret_64_hex

LTI_DEPLOYMENT_IDS=

GEMINI_API_KEY=YOUR_API_KEY_HERE

CANVAS_COURSE_ID=1
CANVAS_API_HOST=canvas.local

CANVAS_ADMIN_PASS=CHANGE_ME_admin_pass_strong
CANVAS_TEACHER_PASS=CHANGE_ME_teacher_pass_strong
CANVAS_STUDENT_PASS=CHANGE_ME_student_pass_strong
LOCAL_DEV_PASSWORD_HASH=$2b$10$CHANGE_ME_local_dev_password_hash

LTI_CLIENT_ID=2

USE_LOCAL_DATA=false
VITE_USE_LOCAL_DATA=false
