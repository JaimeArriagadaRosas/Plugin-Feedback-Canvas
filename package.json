{
  "name": "plugin-feedback",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/client/vite.config.js",
    "server": "node apps/server/src/server.js",
    "build": "vite build --config apps/client/vite.config.js",
    "preview": "vite preview --config apps/client/vite.config.js",
    "start": "node apps/server/src/index.js",
    "deploy:lti": "node scripts/deploy/index.mjs",
    "diagnose": "node scripts/diagnose.mjs",
    "verify:https": "node scripts/verify-https.mjs",
    "setup:hosts": "node scripts/setup-hosts.mjs",
    "setup": "node scripts/setup/index.mjs",
    "test": "vitest run --pool=forks --fileParallelism=false",
    "lint": "eslint apps/server/src --ext .js",
    "test:watch": "vitest --pool=forks --fileParallelism=false",
    "test:integration": "vitest run --project integration --pool=forks --fileParallelism=false",
    "test:coverage": "vitest run --coverage --pool=forks --fileParallelism=false",
    "test:client": "vitest run --config apps/client/vitest.config.js",
    "test:client:watch": "vitest --config apps/client/vitest.config.js",
    "test:e2e": "playwright test -c apps/client/playwright.config.js",
    "test:backend": "vitest run apps/server/tests"
  },
  "dependencies": {
    "@google/generative-ai": "0.24.1",
    "@hookform/resolvers": "5.4.0",
    "@listr2/prompt-adapter-inquirer": "4.2.5",
    "@tanstack/react-query": "5.101.2",
    "nanospinner": "1.2.2",
    "picocolors": "1.1.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "7.81.0",
    "react-router-dom": "7.17.0",
    "react-virtuoso": "4.18.11",
    "sanitize-html": "2.17.6",
    "undici": "6.21.0",
    "zod": "3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testcontainers/postgresql": "12.0.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "chalk": "5.6.2",
    "cross-env": "7.0.3",
    "dotenv": "17.4.2",
    "eslint": "8.57.1",
    "eslint-plugin-security": "1.7.1",
    "execa": "10.0.0",
    "inquirer": "14.0.2",
    "jsdom": "29.1.1",
    "listr2": "11.0.0",
    "msw": "^2.15.0",
    "nock": "14.0.16",
    "supertest": "6.3.0",
    "testcontainers": "12.0.4",
    "vite": "8.1.5",
    "vitest": "3.0.0"
  },
  "overrides": {
    "esbuild": ">=0.25.0",
    "undici": "6.21.0"
  }
}
