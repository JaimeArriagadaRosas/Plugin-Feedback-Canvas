{
  "name": "plugin-feedback",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": "11.8.0"
  },
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:migrate": "node packages/plugin-database/bin/migrate.js",
    "dev": "vite --config apps/client/vite.config.js",
    "server": "node apps/server/src/server.js",
    "build": "vite build --config apps/client/vite.config.js",
    "preview": "vite preview --config apps/client/vite.config.js",
    "start": "node apps/installer/src/preboot.js",
    "deploy:lti": "node apps/installer/src/commands/deploy.js",
    "diagnose": "node apps/installer/src/commands/doctor.js",
    "verify:https": "node apps/installer/src/commands/verifyHttps.js",
    "setup:hosts": "node apps/installer/src/commands/configureHosts.js",
    "setup": "node apps/installer/src/preboot.js --mode=3",
    "test": "vitest run --project=@plugin-feedback/server --project=@plugin-feedback/installer --pool=forks --fileParallelism=false",
    "lint": "eslint . --ext .js,.jsx",
    "test:watch": "vitest --pool=forks --fileParallelism=false",
    "test:integration": "cross-env RUN_DOCKER_TESTS=true vitest run apps/server/tests/integration --pool=forks --fileParallelism=false",
    "test:coverage": "vitest run --coverage --pool=forks --fileParallelism=false",
    "test:client": "vitest run --config apps/client/vitest.config.js",
    "test:client:watch": "vitest --config apps/client/vitest.config.js",
    "test:e2e": "playwright test -c apps/client/playwright.config.js",
    "test:backend": "vitest run apps/server/tests"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testcontainers/postgresql": "12.0.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "autocannon": "^8.0.0",
    "chalk": "5.6.2",
    "cross-env": "7.0.3",
    "eslint": "8.57.1",
    "eslint-plugin-security": "1.7.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "execa": "10.0.0",
    "inquirer": "14.0.2",
    "jsdom": "29.1.1",
    "listr2": "11.0.0",
    "msw": "^2.15.0",
    "nock": "14.0.16",
    "supertest": "6.3.0",
    "testcontainers": "12.0.4",
    "vite": "8.1.5",
    "vitest": "3.0.0"
  },
  "overrides": {}
}
